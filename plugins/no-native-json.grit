// Инвариант 64-битных ID: родной JSON.parse молча округляет 19-значные ID
// (1915016273214320641 → 1915016273214320600), а JSON.stringify бросает на BigInt.
// Разбор и сериализация — только через parseJson/stringifyJson (src/shared/api/json.ts).
// Полный разбор — docs/architecture.md, раздел «Инвариант: 64-битные ID».
//
// Правило глобальное: overrides плагины не отключает (проверено на 2.5.11),
// поэтому исключения помечаются в самих файлах строкой с именем плагина — голое
// lint/plugin заглушило бы и остальные плагины из biome.json:
//   // biome-ignore-all lint/plugin/no-native-json: причина
`JSON.$method($args)` where {
    $method <: or { `parse`, `stringify` },
    register_diagnostic(
        span = $method,
        message = "JSON.parse/stringify запрещены вне транспортного слоя: 64-битные ID теряют точность. Используйте parseJson/stringifyJson из #shared/api/json."
    )
}
