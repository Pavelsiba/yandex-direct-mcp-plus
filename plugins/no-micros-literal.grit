// Деньги: рубли ↔ микроединицы переводят только shared/lib/money (вход — через схему,
// выход — через format). Множитель в другом месте рано или поздно сработает дважды.
or { `1_000_000`, `1000000` } as $hit where {
    register_diagnostic(
        span = $hit,
        message = "Множитель микроединиц вне shared/lib/money: рубли переводит схема (rublesToMicros), обратно — format. Хендлер на миллион не умножает."
    )
}
