{
  "compilerOptions": {
    // Цель — Node >=22 (engines): ES2023 он поддерживает целиком.
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Границы слоёв объявлены subpath imports в package.json (#shared/*, #tools/*,
    // #app/*). Условие development разрешает их в исходники src/*.ts — по нему живут
    // tsc, редактор, vitest и tsx; Node в проде идёт веткой default → dist/*.js.
    "customConditions": ["development"],
    // Те же границы, продублированные для оснастки: knip не резолвит subpath
    // imports (webpro-nl/knip#1256) и без paths считает весь src мёртвым кодом.
    // tsc сюда не заглядывает — он идёт через imports по условию выше.
    "paths": {
      "#app/*": ["./src/app/*"],
      "#shared/*": ["./src/shared/*"],
      "#testing/*": ["./src/testing/*"],
      "#tools/*": ["./src/tools/*"]
    },
    "types": ["node"],

    // Этот конфиг ничего не собирает — он обслуживает typecheck и редактор и
    // покрывает весь репозиторий. Сборка вынесена в tsconfig.build.json:
    // ей нужны rootDir/outDir и исключённые тесты, проверке типов — наоборот.
    "noEmit": true,

    // Конфиги проекта на .js. Проверку каждый включает себе сам строкой
    // // @ts-check, поэтому checkJs не задаём.
    "allowJs": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  // Тесты и конфиги проверяются наравне с src. Vitest срезает типы через esbuild
  // без проверки, так что вне этого списка они не проверяются ничем.
  "include": ["src/**/*", "*.config.ts", "*.config.js"],
  "exclude": ["node_modules", "dist"]
}
